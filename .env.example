# SecureChat — ortam değişkenleri şablonu
# Bu dosyayı ".env" olarak kopyalayın ve değerleri doldurun:
#   cp .env.example .env

# --- Django ---
# Üretimde mutlaka yeni bir anahtar üretin:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=buraya-rastgele-bir-anahtar
DEBUG=True

# --- Veritabanı (PostgreSQL) ---
# docker-compose.yml bu değerleri kullanarak konteyneri kurar.
DB_NAME=securechat
DB_USER=chatuser
DB_PASSWORD=degistirin
DB_HOST=localhost
DB_PORT=5433

# --- Redis (kanal katmanı) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Mesaj ve dosya şifreleme anahtarı ---
# Yeni bir anahtar üretmek için:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# DİKKAT: Bu anahtar kaybolursa mevcut mesajlar ve dosyalar bir daha açılamaz.
FERNET_KEY=buraya-fernet-anahtari

# --- E-posta (doğrulama kodu gönderimi) ---
# Geliştirmede kodları terminale yazdırmak için bu satırı yorum yapın.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST_USER=ornek@gmail.com
EMAIL_HOST_PASSWORD=gmail-uygulama-sifresi
DEFAULT_FROM_EMAIL=SecureChat <ornek@gmail.com>
